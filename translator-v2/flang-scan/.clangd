# Flang headers live in an LLVM install that this machine often does not
# have, so clangd's missing-include diagnostics (and the cascade of
# follow-on errors) are noise. This only affects editor squiggles; the
# real CMake build is unchanged.
#
# Suppress: "*" hides ordinary diagnostics but not fatal_too_many_errors.
# -ferror-limit=0 stops clang hitting that cap in the first place.
Diagnostics:
  Suppress:
    - "*"
    - fatal_too_many_errors
CompileFlags:
  Add: [-ferror-limit=0]
