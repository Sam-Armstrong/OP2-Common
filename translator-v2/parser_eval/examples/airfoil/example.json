{
  "name": "airfoil",
  "description": "Airfoil CFD mini-app (plain variant) from apps/fortran/airfoil",
  "workdir": "../../../../apps/fortran/airfoil",
  "sources": [
    "airfoil_constants.F90",
    "airfoil_kernels.F90",
    "airfoil.F90"
  ],
  "translator_flags": [
    "-DPLAIN",
    "--consts-module",
    "airfoil_constants.F90"
  ],
  "targets": ["seq", "openmp", "c_cuda"],
  "app_name": "airfoil_plain",
  "runtime": {
    "variant": "c_cuda",
    "make_target": "airfoil_plain_c_cuda",
    "binary": "./airfoil_plain_c_cuda",
    "args": ["OP_PART_SIZE=128", "OP_BLOCK_SIZE=192"],
    "pass_regex": "Test PASSED",
    "timeout_s": 180,
    "setup": "ensure_airfoil_grid",
    "runtime_ratio_tol": 0.5
  },
  "codegen_timeout_s": 300
}
