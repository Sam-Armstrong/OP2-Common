{
  "name": "scale_mesh",
  "description": "Large multi-file triangular mesh app for Stage-1 scaling (8 fat kernel modules + main)",
  "workdir": ".",
  "sources": [
    "scale_mesh_consts.F90",
    "scale_mesh_kernels_01.F90",
    "scale_mesh_kernels_02.F90",
    "scale_mesh_kernels_03.F90",
    "scale_mesh_kernels_04.F90",
    "scale_mesh_kernels_05.F90",
    "scale_mesh_kernels_06.F90",
    "scale_mesh_kernels_07.F90",
    "scale_mesh_kernels_08.F90",
    "scale_mesh.F90"
  ],
  "translator_flags": [
    "--consts-module",
    "scale_mesh_consts.F90"
  ],
  "targets": [
    "seq",
    "openmp",
    "c_cuda"
  ],
  "app_name": "scale_mesh",
  "runtime": {
    "variant": "c_cuda",
    "make_target": "scale_mesh_c_cuda",
    "binary": "./scale_mesh_c_cuda",
    "args": [
      "OP_PART_SIZE=128",
      "OP_BLOCK_SIZE=192"
    ],
    "pass_regex": "Test PASSED",
    "timeout_s": 120,
    "runtime_ratio_tol": 0.5
  },
  "codegen_timeout_s": 300
}
